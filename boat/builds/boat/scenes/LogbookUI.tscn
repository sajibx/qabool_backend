[gd_scene load_steps=2 format=3 uid="uid://ddlogbook"]

[gd_script type="GDScript" id="GDScript_logbook"]
script/source = "extends Control

@onready var discovery_label = $Panel/DiscoveryLabel
@onready var stamp_container = $Panel/ScrollContainer/StampGrid
@onready var vista_container = $Panel/VistaContainer/VistaGrid
@onready var shop_container = $Panel/ShopContainer

func _ready():
	_update_ui()
	GameManager.discovery_updated.connect(_on_discovery_updated)
	GameManager.landmark_discovered.connect(_on_discovery_updated)
	GameManager.vista_sketched.connect(_on_discovery_updated)
	
	# Connect Shop Buttons
	$Panel/ShopContainer/LanternBtn.pressed.connect(func(): _on_buy(\"lantern\", 5))
	$Panel/ShopContainer/ParrotBtn.pressed.connect(func(): _on_buy(\"parrot\", 10))
	$Panel/ShopContainer/SailsBtn.pressed.connect(func(): _on_buy(\"crimson_sails\", 15))
	$Panel/HomeBtn.pressed.connect(_on_home_pressed)
	$Panel/CloseBtn.pressed.connect(queue_free)

func _on_home_pressed():
	var env = get_tree().current_scene.get_node_or_null(\"EnvironmentManager\")
	if env and env.current_weather == env.Weather.STORM:
		print(\"Cannot fast travel in a storm!\")
		return
	
	GameManager.fast_travel_home()
	queue_free()

func _update_ui():
	discovery_label.text = \"Discovery Points: \" + str(GameManager.discovery_points)
	
	# Update Stamps
	for child in stamp_container.get_children():
		child.queue_free()
	
	for landmark in GameManager.discovered_landmarks:
		var lbl = Label.new()
		lbl.text = \"[ LANDMARK ]\\n\" + landmark.split(\"_\")[0]
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		stamp_container.add_child(lbl)
		
	# Update Sketches
	for child in vista_container.get_children():
		child.queue_free()
		
	for vista in GameManager.sketched_vistas:
		var lbl = Label.new()
		lbl.text = \"[ SKETCH ]\\n\" + vista.split(\"_\")[0]
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		lbl.theme_override_colors/font_color = Color(1, 0.9, 0.4, 1) # Gold for sketches
		vista_container.add_child(lbl)
		
	# Update Buttons
	if \"lantern\" in GameManager.unlocked_cosmetics: $Panel/ShopContainer/LanternBtn.disabled = true
	if \"parrot\" in GameManager.unlocked_cosmetics: $Panel/ShopContainer/ParrotBtn.disabled = true
	if \"crimson_sails\" in GameManager.unlocked_cosmetics: $Panel/ShopContainer/SailsBtn.disabled = true

func _on_buy(name: String, cost: int):
	if GameManager.unlock_cosmetic(name, cost):
		_update_ui()

func _on_discovery_updated(_pts):
	_update_ui()
"

