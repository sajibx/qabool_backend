[gd_scene load_steps=5 format=3 uid="uid://ddstarshell"]

[sub_resource type="CylinderMesh" id="CylinderMesh_shell"]
top_radius = 0.5
bottom_radius = 0.5
height = 0.1
radial_segments = 5

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_shell"]
albedo_color = Color(1, 0.7, 0.8, 1) # Pinkish Shell

[sub_resource type="CylinderShape3D" id="CylinderShape3D_shell"]
radius = 0.6
height = 0.2

[gd_script type="GDScript" id="GDScript_collect_shell"]
script/source = "extends Interactable

@export var item_type: String = \"shell\"

func interact():
	GameManager.collect_item(item_type)
	_play_pop_and_free()

func _play_pop_and_free():
	var audio = AudioStreamPlayer3D.new()
	audio.stream = load(\"res://audio/water_splash.ogg\") # Placeholder pop
	audio.pitch_scale = 1.5
	get_tree().current_scene.add_child(audio)
	audio.global_position = global_position
	audio.play()
	audio.finished.connect(audio.queue_free)
	queue_free()
"

[node name="StarShell" type="StaticBody3D"]
script = SubResource("GDScript_collect_shell")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
mesh = SubResource("CylinderMesh_shell")
surface_material_override/0 = SubResource("StandardMaterial3D_shell")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
