[gd_script type="GDScript" id="GDScript_relic"]
script/source = "extends Interactable

var is_activated = false

func interact():
	if is_activated: return
	is_activated = true
	
	var relic_mesh = $HoveringRelic
	var mat = relic_mesh.get_surface_override_material(0)
	
	var tween = create_tween()
	# Rotate 90 degrees
	tween.tween_property(relic_mesh, \"rotation_degrees:y\", relic_mesh.rotation_degrees.y + 90, 1.5).set_trans(Tween.TRANS_QUINT).set_ease(Tween.EASE_OUT)
	# Color shift Red -> Cyan
	tween.parallel().tween_property(mat, \"albedo_color\", Color(0, 1, 1, 1), 1.5)
	
	tween.finished.connect(_on_tween_finished)

func _on_tween_finished():
	GameManager.add_ship_blueprint()
	print(\"Relic activated! Blueprint awarded.\")
	# Interaction is already effectively disabled by is_activated check
"
