[gd_script type="GDScript" id="GDScript_merchant"]
script/source = "extends StaticBody3D

func _ready():
	add_to_group(\"merchants\")
	$TradeArea.body_entered.connect(_on_body_entered)

func _on_body_entered(body):
	if body.is_in_group(\"player_ship\"):
		var ui = load(\"res://scenes/TradeUI.tscn\").instantiate()
		get_tree().current_scene.add_child(ui)
"

